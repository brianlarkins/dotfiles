# Per-machine settings kept out of the repo (e.g. the cluster key that Warewulf
# set up on the HPC head node). This has to come before any Host block to apply
# to every host, and since ssh keeps the first value it finds for an option,
# settings in config.local take precedence over the ones below. A missing
# file is silently skipped.
Include ~/.ssh/config.local

# UseKeychain (Host * below) only exists in Apple's ssh; without this, OpenSSH
# on Linux rejects the whole file as "Bad configuration option".
IgnoreUnknown UseKeychain

ForwardAgent yes

Host lotus
  User brian
  HostName lotus.arc.rhodes.edu
  ForwardAgent yes
  ServerAliveInterval 60

Host lotusad
  User larkinsb
  HostName lotus.arc.rhodes.edu
  ForwardAgent yes
  ServerAliveInterval 60

Host admin
  User brian
  HostName 10.10.7.44
  XAuthLocation /usr/X11/bin/xauth
  ForwardX11 yes
  ForwardAgent yes
  ForwardX11Timeout 596h

Host csfs
  User brian
  HostName csfs.arc.rhodes.edu
  ForwardAgent yes

Host cslogin
  User brian
  HostName cslogin.arc.rhodes.edu
  ForwardAgent yes
  ServerAliveInterval 60
  SendEnv LANG LC_*

Host csloginldap
  User larkinsb
  HostName cslogin.arc.rhodes.edu
  ForwardAgent yes

Host senna
  User brian
  HostName senna.rhodes.edu

Host lily
